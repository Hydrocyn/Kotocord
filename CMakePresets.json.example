{
    "_comment": [
        "====================================================================",
        " CMakePresets.json 模板 — 复制为 CMakePresets.json 即可使用",
        "",
        " 本文件不包含任何机器相关的绝对路径。",
        " 本机个人配置请用 CMakeUserPresets.json (已 gitignore, 可写绝对路径)。",
        "",
        " Qt6 通过 MaintenanceTool 安装, 由 CMAKE_PREFIX_PATH 或 Qt6_DIR 定位:",
        "   $env:Qt6_DIR = \"C:\\Qt\\6.9.3\\msvc2022_64\\lib\\cmake\\Qt6\"",
        "",
        " whisper.cpp 经 FetchContent 在 configure 阶段自动拉取 (需网络)",
        " Vosk 从 third_party/vosk/ 手动加载 (预编译包)",
        "===================================================================="
    ],
    "version": 6,
    "configurePresets": [
        {
            "name": "msvc-debug",
            "displayName": "Windows x64 Debug",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/msvc-debug"
        },
        {
            "name": "msvc-release",
            "displayName": "Windows x64 Release",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build/msvc-release"
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "msvc-debug",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "configurePreset": "msvc-release",
            "configuration": "Release"
        }
    ]
}
